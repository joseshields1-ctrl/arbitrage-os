PORT=3000
NODE_ENV=production
FRONTEND_ORIGIN=http://localhost:5173
# Comma-separated list of allowed frontend origins for CORS
# Example: CORS_ALLOWED_ORIGINS=https://specialty-sniper.app,https://www.specialty-sniper.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Poller + scraper configuration
ENABLE_POLLER=false
POLLER_INTERVAL_MS=1200000
# Comma-separated GovDeals URLs used by the poller/import route.
# Supports both category pages and listing detail pages, for example:
# https://www.govdeals.com/en/closing-today,https://www.govdeals.com/en/transportation,https://www.govdeals.com/en/consumer-electronics
GOVDEALS_LISTING_URLS=
# Optional keyword metadata visible in poller status.
POLLER_KEYWORDS=

# SQLite path (recommended when deploying with persistent storage)
SQLITE_DB_PATH=

# Max cards/links to parse from each listing page
GOVDEALS_MAX_LISTING_LINKS=50

# Optional assistant provider key (backend side only)
OPENAI_API_KEY=
