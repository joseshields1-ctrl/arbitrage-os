PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Comma-separated GovDeals listing/discovery pages for Spider start_urls.
# Example:
# GOVDEALS_START_URLS=https://www.govdeals.com/vehicle-search,https://www.govdeals.com/electronics-search
GOVDEALS_START_URLS=

# Max cards/links to parse from each listing page
GOVDEALS_MAX_LISTING_LINKS=50

# Optional assistant provider key (backend side only)
OPENAI_API_KEY=
